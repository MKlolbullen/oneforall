# Runner image — extends the API image with the actual recon tooling so that
# EXECUTION_MODE=live runs work out of the box.
#
# Tool versions are pinned. Bumping a tool means changing one line here.
# The image is build with the repo root as build context (same as the API).

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    GOPATH=/root/go \
    PATH="/usr/local/go/bin:/root/go/bin:/root/.local/bin:${PATH}" \
    GOFLAGS="-buildvcs=false"

WORKDIR /app

# System packages — recon foundation (nmap, dns tools, build chain) and
# anything the Python/Go installs need at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget git unzip jq xz-utils \
        build-essential pkg-config libpcap-dev \
        nmap dnsutils whois \
        python3-pip pipx \
    && rm -rf /var/lib/apt/lists/*

# Pinned Go toolchain.
ARG GO_VERSION=1.22.7
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz

# ---- Go-installed tools (pinned versions, alphabetically) -------------------
# Pins use the published tag for each tool; bumping is a one-line change.

ARG AMASS_VERSION=v4.2.0
ARG ASSETFINDER_VERSION=v0.1.1
ARG CARIDDI_VERSION=v1.4.0
ARG CHAOS_VERSION=v0.5.1
ARG DALFOX_VERSION=v2.9.2
ARG DNSX_VERSION=v1.2.1
ARG FFUF_VERSION=v2.1.0
ARG GAU_VERSION=v2.2.4
ARG GOSPIDER_VERSION=v1.1.6
ARG HTTPX_VERSION=v1.6.10
ARG KATANA_VERSION=v1.1.2
ARG NAABU_VERSION=v2.3.4
ARG NUCLEI_VERSION=v3.3.5
ARG SUBFINDER_VERSION=v2.6.7
ARG TLSX_VERSION=v1.1.7
ARG UNCOVER_VERSION=v1.0.9
ARG WAYBACKURLS_VERSION=v0.1.0

# Round-2 additions
ARG BYP4XX_VERSION=v3.5
ARG CERO_VERSION=v1.4.5
ARG CLOUDFOX_VERSION=v1.14.0
ARG DONTGO403_VERSION=v1.0
ARG JAELES_VERSION=v0.20.4
ARG NOTIFY_VERSION=v1.0.7
ARG OSV_SCANNER_VERSION=v1.9.1
ARG PROXIFY_VERSION=v0.0.16

# Each go install is best-effort and logs its own failure. The smoke check
# in CI (or `make runner-image && docker run ... command -v <bin>`) names
# any binary that didn't end up on PATH, so a single bad pin doesn't
# silently kill the whole image — it just narrows the diagnosis.
#
# The first block is strictly version-pinned (test_runner_image enforces).
# The second block uses @latest for tools whose published-tag stories are
# noisy enough that pinning is more brittle than helpful — see
# test_runner_dockerfile_pins_versions_for_strict_tools for the strict set.
RUN set -ux && \
    go_install() { go install "$1" && echo "OK  $1" || echo "FAIL $1"; }; \
    go_install "github.com/owasp-amass/amass/v4/cmd/amass@${AMASS_VERSION}"; \
    go_install "github.com/tomnomnom/assetfinder@${ASSETFINDER_VERSION}"; \
    go_install "github.com/edoardottt/cariddi/cmd/cariddi@${CARIDDI_VERSION}"; \
    go_install "github.com/projectdiscovery/chaos-client/cmd/chaos@${CHAOS_VERSION}"; \
    go_install "github.com/hahwul/dalfox/v2@${DALFOX_VERSION}"; \
    go_install "github.com/projectdiscovery/dnsx/cmd/dnsx@${DNSX_VERSION}"; \
    go_install "github.com/ffuf/ffuf/v2@${FFUF_VERSION}"; \
    go_install "github.com/lc/gau/v2/cmd/gau@${GAU_VERSION}"; \
    go_install "github.com/jaeles-project/gospider@${GOSPIDER_VERSION}"; \
    go_install "github.com/projectdiscovery/httpx/cmd/httpx@${HTTPX_VERSION}"; \
    go_install "github.com/projectdiscovery/katana/cmd/katana@${KATANA_VERSION}"; \
    go_install "github.com/projectdiscovery/naabu/v2/cmd/naabu@${NAABU_VERSION}"; \
    go_install "github.com/projectdiscovery/nuclei/v3/cmd/nuclei@${NUCLEI_VERSION}"; \
    go_install "github.com/projectdiscovery/subfinder/v2/cmd/subfinder@${SUBFINDER_VERSION}"; \
    go_install "github.com/projectdiscovery/tlsx/cmd/tlsx@${TLSX_VERSION}"; \
    go_install "github.com/projectdiscovery/uncover/cmd/uncover@${UNCOVER_VERSION}"; \
    go_install "github.com/tomnomnom/waybackurls@${WAYBACKURLS_VERSION}"; \
    go_install "github.com/lobuhi/byp4xx@${BYP4XX_VERSION}"; \
    go_install "github.com/glebarez/cero@${CERO_VERSION}"; \
    go_install "github.com/BishopFox/cloudfox@${CLOUDFOX_VERSION}"; \
    go_install "github.com/devploit/dontgo403@${DONTGO403_VERSION}"; \
    go_install "github.com/jaeles-project/jaeles@${JAELES_VERSION}"; \
    go_install "github.com/projectdiscovery/notify/cmd/notify@${NOTIFY_VERSION}"; \
    go_install "github.com/google/osv-scanner/cmd/osv-scanner@${OSV_SCANNER_VERSION}"; \
    go_install "github.com/projectdiscovery/proxify/cmd/proxify@${PROXIFY_VERSION}"; \
    go_install "github.com/projectdiscovery/asnmap/cmd/asnmap@latest"; \
    go_install "github.com/projectdiscovery/urlfinder/cmd/urlfinder@latest"; \
    go_install "github.com/hakluke/hakrawler@latest"; \
    go_install "github.com/sensepost/gowitness@latest"; \
    go_install "github.com/bp0lr/gauplus@latest"; \
    go_install "github.com/tomnomnom/qsreplace@latest"; \
    go_install "github.com/tomnomnom/gf@latest"; \
    go_install "github.com/ThreatUnkown/jsubfinder@latest"; \
    true

# ---- Rust toolchain + cargo-installed tools ---------------------------------
# x8 is a Rust binary; install rustup, then cargo install x8.
ARG X8_VERSION=4.3.0
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal \
    && /root/.cargo/bin/cargo install --quiet "x8@${X8_VERSION}" || true
ENV PATH="/root/.cargo/bin:${PATH}"

# ---- Python tools via pipx (each in its own venv) ---------------------------
# pipx ensures these don't fight with the API's dependencies.

ARG ARJUN_VERSION=2.2.7
ARG URO_VERSION=1.0.0
ARG WAYMORE_VERSION=4.4.7
ARG XNLINKFINDER_VERSION=2.0.7
ARG WAPPALYZER_VERSION=2.1.0
# Round-2 additions
ARG BBOT_VERSION=2.1.1
ARG PROWLER_VERSION=4.5.0
ARG SCOUTSUITE_VERSION=5.14.0
ARG APKLEAKS_VERSION=2.6.3
ARG DIRHUNT_VERSION=0.9.4
ARG URLESS_VERSION=1.4.0
# Round-3: AD/lateral-movement tools. Both ship as pipx packages on PyPI; the
# impacket suite drops ~15 binaries (impacket-secretsdump, -smbexec, -psexec,
# -wmiexec, -GetUserSPNs, ...). Pinned conservatively to recent stable.
ARG IMPACKET_VERSION=0.12.0
ARG NETEXEC_VERSION=1.5.2
# Web-app testing additions: XSStrike (XSS engine, ships as a script — installed
# from git so the binary lives at /opt/xsstrike/xsstrike.py and gets a wrapper)
# and XSRFProbe (CSRF probe, pipx-installable from PyPI).
ARG XSRFPROBE_VERSION=2.5

RUN pipx install "arjun==${ARJUN_VERSION}" || true && \
    pipx install "uro==${URO_VERSION}" || true && \
    pipx install "waymore==${WAYMORE_VERSION}" || true && \
    pipx install "xnLinkFinder==${XNLINKFINDER_VERSION}" || true && \
    pipx install "wappalyzer==${WAPPALYZER_VERSION}" || true && \
    pipx install "bbot==${BBOT_VERSION}" || true && \
    pipx install "prowler==${PROWLER_VERSION}" || true && \
    pipx install "scoutsuite==${SCOUTSUITE_VERSION}" || true && \
    pipx install "apkleaks==${APKLEAKS_VERSION}" || true && \
    pipx install "dirhunt==${DIRHUNT_VERSION}" || true && \
    pipx install "urless==${URLESS_VERSION}" || true && \
    pipx install "impacket==${IMPACKET_VERSION}" || true && \
    pipx install "netexec==${NETEXEC_VERSION}" || true && \
    pipx install "xsrfprobe==${XSRFPROBE_VERSION}" || true

# ---- XSStrike — git clone + wrapper -----------------------------------------
# Upstream XSStrike has no PyPI release; clone to /opt and drop a wrapper
# on PATH so the runner can invoke `xsstrike` like every other tool.
RUN git clone --depth 1 https://github.com/s0md3v/XSStrike.git /opt/xsstrike \
    && pip install --no-cache-dir -r /opt/xsstrike/requirements.txt \
    && printf '#!/bin/sh\nexec python3 /opt/xsstrike/xsstrike.py "$@"\n' > /usr/local/bin/xsstrike \
    && chmod +x /usr/local/bin/xsstrike \
    || true

# ---- Nuclei templates --------------------------------------------------------
# Materialize templates so the first nuclei run doesn't fight the network.
RUN nuclei -update-templates -silent -duc || true

# ---- Application + legacy package -------------------------------------------
COPY apps/api /app/apps/api
COPY legacy /app/legacy
WORKDIR /app/apps/api
RUN pip install --no-cache-dir -e . \
    && pip install --no-cache-dir -e /app/legacy

# Default command: run the worker so this image can be the worker target.
# Compose's api service can override with uvicorn for the API role.
EXPOSE 8000
CMD ["python", "-m", "app.worker"]
