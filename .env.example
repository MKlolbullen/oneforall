APP_NAME=ReconForge
ENVIRONMENT=dev
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

DATABASE_URL=postgresql+psycopg://reconforge:reconforge@postgres:5432/reconforge
REDIS_URL=redis://redis:6379/0
RUNNER_MODE=queue
RUN_QUEUE_NAME=reconforge:runs:queue
REDIS_EVENT_CHANNEL_PREFIX=reconforge:runs

ARTIFACT_BACKEND=s3
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=reconforge
MINIO_SECRET_KEY=reconforge-secret
MINIO_BUCKET=artifacts
S3_REGION=us-east-1

TOOL_REGISTRY_DIR=/app/tool-registry/tools
PROFILE_REGISTRY_DIR=/app/tool-registry/profiles
# Safe default: no real tools execute until both switches are flipped.
# For an explicitly authorized closed lab only:
#   EXECUTION_MODE=live
#   ALLOW_LIVE_EXECUTION=true
EXECUTION_MODE=dry_run
ALLOW_LIVE_EXECUTION=false
# Dry-run pacing. 0.05s makes scans readable in a demo; set to 0 in CI.
DRY_RUN_LINE_DELAY_SECONDS=0.05
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth bootstrap. The first boot creates this admin user. Change the password
# (and rotate via /api/auth/users) before any non-lab deployment.
RECONFORGE_BOOTSTRAP_ADMIN_USERNAME=admin
RECONFORGE_BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Optional: extra HMAC over every audit event body. Without this, the chain is
# still tamper-evident via SHA-256, but anyone with DB write access could
# fabricate a self-consistent forged tail. With a key, they can't unless they
# also steal it.
# RECONFORGE_AUDIT_HMAC_KEY=replace-with-32-bytes-of-randomness

# Tool availability guardrails. In live mode, missing/broken profile tools block run creation.
TOOL_AVAILABILITY_CACHE_SECONDS=15
TOOL_AVAILABILITY_PROBE_TIMEOUT_SECONDS=1.5
BLOCK_LIVE_RUNS_ON_MISSING_TOOLS=true

# Sn1per-inspired configuration pack
PLATFORM_CONFIG_PATH=../../packages/platform-config/sniper-inspired.yaml
GREP_PATTERNS_PATH=../../packages/patterns/sniper-grep-patterns.yaml
WORDLISTS_DIR=../../packages/wordlists

# Optional Sn1per-style overrides. Keep secrets out of git.
# OUT_OF_SCOPE=example.org,*.corp.example.org
# MAX_HOSTS=2000
# THREADS=100
# MAX_JAVASCRIPT_FILES=25
# NUCLEI=1
# DIRSEARCH=1
# NIKTO=1
# WPSCAN=1
# BURP_SCAN=0
# ZAP_SCAN=0
# OPENVAS=0
# NESSUS=0
# SHODAN_API_KEY=
# CENSYS_APP_ID=
# CENSYS_API_SECRET=
# HUNTERIO_KEY=
# TOMBAIO_KEY=
# TOMBAIO_SECRET=
# GITHUB_API_KEY=
# WP_API_KEY=
# URLSCAN_API_KEY=
# SLACK_WEBHOOK_URL=
